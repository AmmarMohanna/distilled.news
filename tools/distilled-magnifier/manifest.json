{
  "manifest_version": 3,
  "name": "Distilled.news Magnifier — Joud trial",
  "version": "0.1.0",
  "description": "Use browser-menu zoom as visual magnification on the Joud Distilled.news instance.",
  "host_permissions": ["https://distilled-news-joud.distillednews-platform.workers.dev/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["https://distilled-news-joud.distillednews-platform.workers.dev/*"],
    "js": ["content.js"],
    "run_at": "document_start"
  }],
  "action": {"default_title": "Reset Distilled.news magnification to 100%"}
}

# Distilled.news environment example
#
# Copy this file to `.env` for local development. Do not commit real secrets.

# Cloudflare
# API token used by Wrangler/automation to deploy Workers, D1, R2, Queues,
# and related Cloudflare resources.
CLOUDFLARE_API_TOKEN=

# Cloudflare account ID that owns the Worker and storage resources.
CLOUDFLARE_ACCOUNT_ID=

# Optional Cloudflare zone ID for custom automation outside the setup script.
# Not required for the default workers.dev deployment path.
CLOUDFLARE_ZONE_ID=

# Cloudflare AI Gateway identifier/name used to route OpenAI requests through
# Cloudflare AI Gateway. `default` auto-creates on first authenticated request
# for third-party models.
CLOUDFLARE_AI_GATEWAY_ID=default

# Self-host resource names. Copy the production Wrangler environment and replace
# every Distilled-owned resource before deploying a fork.
DISTILLED_WORKER_NAME=distilled-news
DISTILLED_D1_DATABASE_NAME=distilled-news
DISTILLED_D1_DATABASE_ID=
DISTILLED_R2_BUCKET_NAME=distilled-news-raw
DISTILLED_PROCESSING_QUEUE_NAME=distilled-news-processing
DISTILLED_PROCESSING_DEAD_LETTER_QUEUE_NAME=distilled-news-processing-dlq
DISTILLED_SOURCE_QUEUE_NAME=distilled-news-sources
DISTILLED_SOURCE_DEAD_LETTER_QUEUE_NAME=distilled-news-sources-dlq
DISTILLED_EDITION_QUEUE_NAME=distilled-news-editions
DISTILLED_EDITION_DEAD_LETTER_QUEUE_NAME=distilled-news-editions-dlq

# Optional comma-separated custom domains, for example:
# distilled.example.com,www.distilled.example.com
DISTILLED_CUSTOM_DOMAINS=

# Staging and restore IDs must identify dedicated non-production databases.
DISTILLED_STAGING_D1_DATABASE_ID=
STAGING_RESTORE_DATABASE_NAME=distilled-news-staging-restore
STAGING_RESTORE_DATABASE_ID=

# Release-operator secrets. Keep these in protected CI/environment secret
# storage; they are not Worker bindings and are not written to deploy secrets.
# 32 random bytes encoded as unpadded base64url. This encrypts private D1
# recovery objects and is not a Worker binding.
BACKUP_ENCRYPTION_KEY=
# Staging-canary only: authenticates rolling state artifacts.
CANARY_STATE_HMAC_KEY=
# Staging-canary only: base64 DER Ed25519 PKCS8 private key.
CANARY_ATTESTATION_PRIVATE_KEY=
# Production only: base64 DER Ed25519 SPKI public key.
CANARY_ATTESTATION_PUBLIC_KEY=
# Production only: short-lived release-bound JSON containing only SHA-256
# digests and opaque references for completed public-launch gates. This is
# reviewed evidence, not an API credential.
PUBLIC_LAUNCH_ATTESTATION=

# Cloudflare API token with AI Gateway Run/Edit access, sent as the
# cf-aig-authorization header when your gateway requires Cloudflare auth.
# For local setup this can be the same token used by Wrangler, but a narrower
# gateway-only token is preferred for production.
CLOUDFLARE_AI_GATEWAY_TOKEN=

# OpenAI
# OpenAI API key used for relevance filtering and summarization through
# Cloudflare AI Gateway.
OPENAI_API_KEY=

# Optional for a self-hosted default project; required by the hosted
# production/staging release configuration so usage and limits stay isolated.
OPENAI_PROJECT_ID=

# OpenAI chat model used for production summaries through AI Gateway.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EDITION_MODEL=gpt-4.1-mini
OPENAI_EDITION_FALLBACK_MODEL=gpt-4.1-nano
EDITION_SYNTHESIS_MODE=all
OPENAI_INPUT_PRICE_USD_PER_MILLION_TOKENS=0.40
OPENAI_OUTPUT_PRICE_USD_PER_MILLION_TOKENS=1.60
OPENAI_SUMMARY_MAX_INPUT_TOKENS=1000000
OPENAI_IMPORTANCE_REVIEW_MAX_INPUT_TOKENS=1000000
OPENAI_EVENT_REVIEW_MAX_INPUT_TOKENS=1000000
OPENAI_EDITION_MAX_INPUT_TOKENS=1000000
OPENAI_SUMMARY_MAX_OUTPUT_TOKENS=300
OPENAI_REVIEW_MAX_OUTPUT_TOKENS=80
OPENAI_EDITION_MAX_OUTPUT_TOKENS=1600
HOSTED_LLM_ACCOUNT_DAILY_BUDGET_USD=0.10
HOSTED_LLM_ACCOUNT_MONTHLY_BUDGET_USD=2
GLOBAL_LLM_DAILY_BUDGET_USD=3
GLOBAL_LLM_MONTHLY_BUDGET_USD=90
GLOBAL_COLLECTION_DAILY_BUDGET_USD=3
GLOBAL_COLLECTION_MONTHLY_BUDGET_USD=90
TOTAL_MONTHLY_BUDGET_USD=300

# Apify
# Optional token used for curated live source actors. Required for Google News,
# `x:`, `linkedin:`, and `apify:` sources.
APIFY_API_TOKEN=
# Optional CI-only account-read credential. When omitted, readiness uses the
# existing APIFY_API_TOKEN.
APIFY_READINESS_TOKEN=
APIFY_EXPECTED_USER_ID=
APIFY_EXPECTED_PLAN_TIER=
APIFY_EXPECTED_MAX_MONTHLY_USAGE_USD=
APIFY_GOOGLE_NEWS_ACTOR_ID=groupoject/google-news-scraper
APIFY_GOOGLE_NEWS_ACTOR_BUILD=1.1.1
APIFY_GOOGLE_NEWS_PRICE_USD_PER_1000_RESULTS=0.50
APIFY_GOOGLE_NEWS_FALLBACK_ACTOR_ID=solidcode/google-news-scraper
APIFY_GOOGLE_NEWS_FALLBACK_ACTOR_BUILD=1.0.10
APIFY_GOOGLE_NEWS_FALLBACK_PRICE_USD_PER_1000_RESULTS=1.20

# Optional reliable fallback for Google News query sources when Google's free
# RSS endpoint rejects Cloudflare egress. Brave requires a plan that explicitly
# grants storage rights before its results can be retained in public briefs.
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_STORAGE_RIGHTS_CONFIRMED=false

# Actor IDs are configurable because Apify Store actors can change schema,
# pricing, or reliability over time.
APIFY_X_ACTOR_ID=xquik/x-tweet-scraper
APIFY_X_ACTOR_BUILD=1.1.3
APIFY_X_PRICE_USD_PER_1000_RESULTS=0.15
APIFY_LINKEDIN_COMPANY_ACTOR_ID=harvestapi/linkedin-company-posts
APIFY_LINKEDIN_PROFILE_ACTOR_ID=harvestapi/linkedin-profile-posts

# Raw source payloads are short-lived debugging evidence, not a permanent
# archive. Configure the bucket lifecycle manually as documented in
# docs/SELF-HOSTING.md, then confirm it with `pnpm retention:verify`.
RAW_ARCHIVE_BUCKET=
RAW_ARCHIVE_RETENTION_DAYS=30

# Distilled app secrets
# Secret used to sign/admin-protect the self-hosted admin surface.
ADMIN_SESSION_SECRET=

# Initial setup token used once to create the admin password in a self-hosted
# install. Generate a long random value before deploying.
ADMIN_SETUP_TOKEN=

# Required internal secret for maintenance endpoints such as retention cleanup.
INTERNAL_MAINTENANCE_SECRET=

# Email address used by Cloudflare Email Service for verification and reset
# messages. The sender domain must be onboarded for Cloudflare Email Sending.
# Public signups also require Email Sending for arbitrary recipients; Email
# Routing-only bindings can send only to verified destination addresses.
EMAIL_FROM="Distilled.news <noreply@example.com>"

# Fixed recipient for the protected registration readiness check. Use an
# external plus-address that is not a verified Cloudflare Email Routing
# destination. Configure it as a Worker secret and a protected GitHub
# environment secret; never accept it from an HTTP request.
EMAIL_CANARY_RECIPIENT=

# Optional Turnstile keys for public signup/reset/login abuse control.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAMES=
TURNSTILE_EXPECTED_ACTION=register

# Hosted runtime policy. Production fails closed if registration or provider
# configuration is absent or invalid.
ENVIRONMENT=staging
REGISTRATION_MODE=closed
HOSTED_ACCOUNT_CAP=50
HOSTED_PENDING_ACCOUNT_CAP=10
RELEASE_SHA=local-development
PROVIDER_RSS_ENABLED=true
PROVIDER_TELEGRAM_ENABLED=true
PROVIDER_GOOGLE_NEWS_ENABLED=false
PROVIDER_X_ENABLED=false
PROVIDER_LINKEDIN_ENABLED=false
PROVIDER_GENERIC_APIFY_ENABLED=false
PROVIDER_BRAVE_ENABLED=false

# Public URLs
# Worker/API base URL. For early testing this can be a workers.dev URL.
PUBLIC_API_BASE_URL=

# Public web/feed base URL. Can be distilled.news, a custom self-hosted domain,
# or a local development URL.
PUBLIC_WEB_BASE_URL=

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "publication-validation-labels-v2"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "reviewedAt": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "enum": [
        "INDEPENDENT_HUMAN",
        "HUMAN_ASSISTED",
        "AI_ASSISTED",
        "INVESTIGATOR",
        "CONTROLLED_FIXTURE"
      ]
    },
    "previouslyReadAudit": {
      "type": "boolean"
    },
    "modelAssistanceUsed": {
      "type": "boolean"
    },
    "evidenceInspected": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifact": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "artifact",
          "sha256",
          "scope"
        ]
      }
    },
    "sourceManifestSha256": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "required": [
    "schemaVersion",
    "reviewer",
    "reviewedAt",
    "provenance",
    "previouslyReadAudit",
    "modelAssistanceUsed",
    "evidenceInspected",
    "sourceManifestSha256",
    "cases"
  ],
  "$defs": {
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "section": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "COMPLETE_STORY_SECTION",
            "COMPLETE_CONTROL_READER"
          ]
        },
        "scopeSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "artifact",
        "sha256",
        "section"
      ],
      "oneOf": [
        {
          "required": [
            "quote",
            "start",
            "end",
            "kind"
          ]
        },
        {
          "required": [
            "scope",
            "scopeSha256"
          ]
        }
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claimId": {
          "type": "string",
          "minLength": 1
        },
        "readerText": {
          "type": "string",
          "minLength": 1
        },
        "support": {
          "enum": [
            "SUPPORTED",
            "ERROR",
            "UNRESOLVED"
          ]
        },
        "errorKind": {
          "enum": [
            "UNSUPPORTED_ADDITION",
            "DISTORTED_FACT",
            null
          ]
        },
        "facets": {
          "type": "array",
          "items": {
            "enum": [
              "IDENTITY",
              "SUBJECT_PREDICATE",
              "QUANTITY_UNIT_BOUND",
              "TIME_ROLE",
              "ATTRIBUTION",
              "MODALITY",
              "NEGATION",
              "CAUSATION"
            ]
          }
        },
        "sourceWitnesses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/witness"
          }
        },
        "readerWitnesses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/witness"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "claimId",
        "readerText",
        "support",
        "errorKind",
        "facets",
        "sourceWitnesses",
        "readerWitnesses",
        "reason"
      ]
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "propositionId": {
          "type": "string",
          "minLength": 1
        },
        "sourcePropositionText": {
          "type": "string",
          "minLength": 1
        },
        "editorialRequirementId": {
          "type": [
            "string",
            "null"
          ]
        },
        "materiality": {
          "enum": [
            "REQUIRED",
            "OPTIONAL",
            "NOT_NEWS",
            "UNRESOLVED"
          ]
        },
        "communication": {
          "enum": [
            "COMMUNICATED",
            "OMITTED",
            "UNRESOLVED"
          ]
        },
        "sourceWitnesses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/witness"
          }
        },
        "readerWitnesses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/witness"
          }
        },
        "omissionScopeWitnesses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/witness"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "propositionId",
        "sourcePropositionText",
        "editorialRequirementId",
        "materiality",
        "communication",
        "sourceWitnesses",
        "readerWitnesses",
        "omissionScopeWitnesses",
        "reason"
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[ST][0-9]{2}$"
        },
        "reviewState": {
          "enum": [
            "UNREVIEWED",
            "PARTIAL",
            "REVIEWED"
          ]
        },
        "readerScopesInspected": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/witness"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "claims": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/claim"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "requirements": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/requirement"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "reviewState",
        "readerScopesInspected",
        "claims",
        "requirements",
        "reason"
      ]
    }
  }
}

{
  "name": "distilled-news",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare-first, self-hostable personal news briefing filter.",
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "provision:x": "node scripts/provision-authenticated-profile.mjs",
    "bootstrap:x": "node scripts/trigger-authenticated-profile-bootstrap.mjs",
    "diagnostic:x": "node scripts/trigger-authenticated-surface-diagnostic.mjs",
    "browser-worker:check": "pnpm --filter @distilled/agent-runtime test:browser",
    "browser-bridge:dev": "pnpm --filter @distilled/browser-bridge dev",
    "browser-bridge:build": "pnpm --filter @distilled/browser-bridge build",
    "dev": "pnpm --filter @distilled/worker dev",
    "build": "pnpm --filter @distilled/core build && pnpm --filter @distilled/connectors build && pnpm --filter @distilled/web build && pnpm --filter @distilled/worker build",
    "typecheck": "pnpm -r typecheck",
    "test": "node --test scripts/*.test.mjs && pnpm -r test",
    "test:e2e": "playwright test",
    "deploy": "pnpm --filter @distilled/worker run deploy",
    "db:migrate": "pnpm --filter @distilled/worker db:migrate",
    "web-operator:live-smoke:trigger": "node scripts/trigger-live-public-acquisition-smoke.mjs",
    "openrouter:diagnostic:trigger": "node scripts/trigger-openrouter-model-diagnostic.mjs",
    "setup": "node scripts/setup.mjs",
    "bootstrap:x:manual": "node scripts/bootstrap-authenticated-profile-manual.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}

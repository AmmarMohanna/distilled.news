{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "distilled-provisional",
      "folder": "Distilled private",
      "interval": "1m",
      "rules": [
        {
          "uid": "distilled-publication-failures",
          "title": "Repeated scoped publication failures",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 900,
                "to": 0
              },
              "datasourceUid": "distilled-metrics",
              "model": {
                "refId": "A",
                "expr": "sum(distilled_publication_failed{job=\"distilled-snapshot\"})",
                "instant": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200,
                "queryType": "instant",
                "format": "time_series"
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "classic_conditions",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        2
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "A"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "type": "query"
                  }
                ]
              }
            }
          ],
          "noDataState": "NoData",
          "execErrState": "Error",
          "isPaused": true,
          "labels": {
            "service": "distilled",
            "severity": "warning",
            "threshold_status": "provisional"
          },
          "annotations": {
            "summary": "Repeated scoped publication failures",
            "description": "Provisional engineering trigger; not a measured SLA.",
            "runbook_url": "https://github.com/AmmarMohanna/distilled.news/blob/feat/agentops-k6-observability/docs/observability/RUNBOOKS.md#publication"
          },
          "for": "10m"

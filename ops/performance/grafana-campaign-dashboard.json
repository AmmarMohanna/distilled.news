{
  "uid": "distilled-real-campaigns-v1",
  "title": "Distilled staging real campaigns",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "staging",
    "private",
    "campaign"
  ],
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "profile",
        "type": "custom",
        "query": "load,spike,stress,soak,recovery,agentops",
        "current": {
          "text": "load",
          "value": "load"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Scheduled opportunities",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "distilled_campaign_opportunities_offered{environment=\"staging\",profile=\"$profile\",slot=\"isolated-campaign\"}"
        }
      ]
    },
    {

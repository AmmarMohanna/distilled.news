{
  "name": "distilled-news-production-agentops",
  "account_id": "e32b564514d4f9b9e383b7dd30dbb026",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-05",
  "workers_dev": false,
  "preview_urls": false,
  "limits": {
    "cpu_ms": 100
  },
  "routes": [],
  "vars": {
    "COLLECTOR_ENABLED": "true",
    "COLLECTOR_FEED_ID": "",
    "COLLECTOR_SCOPE": "deployment",
    "GRAFANA_OTLP_METRICS_URL": "https://otlp-gateway-prod-eu-west-2.grafana.net/otlp/v1/metrics",
    "DEPLOYMENT_ENVIRONMENT": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "distilled-news-production",
      "database_id": "070dcb92-88e1-463b-bb93-b95b81203810"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "secrets": {
    "required": [
      "GRAFANA_OTLP_AUTH"
    ]
  }
}

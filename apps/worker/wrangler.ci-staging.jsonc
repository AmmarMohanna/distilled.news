{
  "name": "distilled-news-ci-staging",
  "account_id": "e32b564514d4f9b9e383b7dd30dbb026",
  "main": "src/staging.ts",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [],
  "vars": {
    "CI_STAGING_READ_ONLY": "true",
    "PUBLIC_WEB_BASE_URL": "https://distilled-news-ci-staging.distillednews-platform.workers.dev",
    "PUBLIC_API_BASE_URL": "https://distilled-news-ci-staging.distillednews-platform.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "distilled-news-ci-staging",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {"enabled": true},
  "secrets": {"required": ["ADMIN_SESSION_SECRET"]}
}

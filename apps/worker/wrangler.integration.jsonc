// Independent integration Worker; staging configuration and workflow remain unchanged.
// Shared staging data and producer queues; staging alone owns Cron and consumers.
// Only admin secrets are required here: the owner authorized omitting 12 unavailable staging secrets.
// See documentation/INTEGRATION_DEPLOYMENT.md for the full comparison and limitations.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "distilled-news-integration",
  "account_id": "e32b564514d4f9b9e383b7dd30dbb026",
  "main": "src/staging.ts",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [],
  "vars": {
    "CLOUDFLARE_IMAGE_ACCOUNT_ID": "e32b564514d4f9b9e383b7dd30dbb026",
    "DISTILLED_LIVE_OPENROUTER_MODEL": "openai/gpt-4.1-mini",
    "DISTILLED_LIVE_PUBLIC_ACQUISITION_SMOKE": "false",
    "DISTILLED_LLM_API_GATEWAY": "openrouter",
    "DISTILLED_NEWS_PIPELINE_EVALUATION": "false",
    "DISTILLED_WEB_OPERATOR_ENABLED": "false",
    "EMAIL_FROM": "Distilled.news <distilled.news@outlook.com>",
    "MAIL_TRANSPORT": "OUTLOOK_GRAPH",
    "PRODUCT_FEEDS_ENABLED": "true",
    "PUBLIC_API_BASE_URL": "https://distilled-news-integration.distillednews-platform.workers.dev",
    "PUBLIC_WEB_BASE_URL": "https://distilled-news-integration.distillednews-platform.workers.dev",
    "SOURCE_CONNECTORS_ENABLED": "true",
    "SOURCE_EXECUTION_URL": "http://127.0.0.1:8790/v1/source-execution",
    "SOURCE_FULL_ARTICLES_ENABLED": "true",
    "SOURCE_LEGACY_POLLING_ENABLED": "false",
    "SOURCE_OPERATION_CEILINGS_JSON": "{\"twitterApiIo\":0.01,\"apify\":0,\"zyte\":0}",
    "SOURCE_PROVIDER_BUDGETS_JSON": "{\"x_twitterapi_io\":10.01,\"x_apify\":0,\"google_apify\":0,\"linkedin_apify\":0,\"zyte\":0}",
    "SOURCE_QUEUE_SCHEDULING_ENABLED": "true",
    "SOURCE_RECOMMENDATIONS_ENABLED": "false",
    "SOURCE_SHARED_PUBLIC_FETCH_ENABLED": "true",
    "STAGING_ASSETS_PREFIX": "staging-assets/758837e409f03d248288de04909e981d680abf6a/",
    "V1_BROWSER_ACQUISITION_ENABLED": "false",
    "V1_DOWNSTREAM_ENABLED": "true",
    "V1_DOWNSTREAM_FEED_SOURCE_IDS": "staging-rss-source,staging-twitter-source",
    "V1_EDITORIAL_MODEL_POLICY": "SEMANTIC",
    "V1_EDITORIAL_PLAN_ENABLED": "true",
    "V1_EDITORIAL_RANKING_POLICY": "SEMANTIC",
    "V1_REAL_MODEL_REQUIRED": "true",
    "V1_SALIENCE_POLICY": "DETERMINISTIC",
    "V1_SEMANTIC_POLICY": "SEMANTIC",
    "V1_SEMANTIC_STRONG_MODEL": "openai/gpt-4.1-mini",
    "V1_SYNTHESIS_MODEL_ENABLED": "true"
  },
  "secrets": {
    "required": [
      "ADMIN_SESSION_SECRET",
      "ADMIN_SETUP_TOKEN"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "distilled-news-staging",
      "database_id": "ab259bfe-6029-4e20-8cb6-eea6b7a67459",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RAW_ARCHIVE",
      "bucket_name": "distilled-news-staging-raw"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "PROCESSING_QUEUE",
        "queue": "distilled-news-staging-processing"
      },
      {
        "binding": "SOURCE_COLLECTION_QUEUE",
        "queue": "distilled-news-staging-collection"
      },
      {
        "binding": "V1_ACQUISITION_QUEUE",
        "queue": "distilled-news-staging-acquisition"
      },
      {
        "binding": "V1_PROCESSING_QUEUE",
        "queue": "distilled-news-staging-v1"
      }
    ],
    "consumers": []
  },
  "vpc_services": [
    {
      "binding": "SOURCE_EXECUTION_SERVICE",
      "service_id": "01a1099d-e88a-7c23-a1c5-eeb51471e780"
    }
  ],
  "triggers": {
    "crons": []
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "logpush": false,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}

{
  "name": "@distilled/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env staging",
    "build": "wrangler deploy --dry-run --env production --outdir dist",
    "deploy": "node ../../scripts/release/deploy.mjs production",
    "deploy:staging": "node ../../scripts/release/deploy.mjs staging",
    "db:migrate": "wrangler d1 migrations apply DB --local --env staging",
    "db:migrate:remote": "node ../../scripts/release/migrate.mjs production",
    "types:wrangler": "wrangler types worker-configuration.d.ts --env production --env-file /dev/null --include-runtime=false --strict-vars=false",
    "types:wrangler:check": "wrangler types worker-configuration.d.ts --env production --env-file /dev/null --include-runtime=false --strict-vars=false --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.0",
    "@distilled/connectors": "workspace:*",
    "@distilled/core": "workspace:*",
    "hono": "4.12.27",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260729.1",
    "typescript": "^5.8.3",
    "vitest": "4.1.10",
    "wrangler": "4.115.0"
  }
}
